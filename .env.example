# Default: local access or a reverse proxy on the server.
# Set to 0.0.0.0 for access through the server's IP on a trusted network.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000

# Address reachable from the container; localhost means the container itself.
ES_URL=http://host.docker.internal:9200
ES_INDEX=entity
ES_USERNAME=
ES_PASSWORD=
ES_TYPE_FIELD=type.keyword
ES_NAME_FIELD=zhLabel.keyword
DEDUP_BATCH_SIZE=5000
ES_MAX_CONCURRENCY=2
